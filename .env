# ============================================
# ZQ Platform - Docker Compose 环境变量配置
# ============================================

# 应用配置
APP_NAME=ZQ-Platform

# PostgreSQL 配置
DB_NAME=zq_platform
DB_USER=postgres
DB_PASSWORD=postgres
# 主机映射端口（留空则不映射到宿主机；格式: "5432" 或 "15432:5432"）
DB_PORT_MAPPING=

# Redis 配置
REDIS_PASSWORD=redis123
# 主机映射端口（留空则不映射到宿主机）
REDIS_PORT_MAPPING=

# JWT 密钥（生产环境请务必修改！）
JWT_SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 文件存储
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=/app/storage

# 时区
TIMEZONE=Asia/Shanghai

# 缓存前缀
CACHE_PREFIX=zq-platform:prod:

# Nginx 端口映射
WEB_PORT=8080

# 后端端口映射
BACKEND_PORT_MAPPING=
